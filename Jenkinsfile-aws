pipeline {
    agent any

    environment {
        //NETLIFY_SITE_ID = 'e853f019-b741-4bea-8046-382a8f4764a7'
        //NETLIFY_AUTH_TOKEN = credentials('netlify-token')
        REACT_APP_VERSION = "1.0.$BUILD_ID"
    }

    stages {
        stage('Test') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    echo "Test Stage"
                    node --version
                    npm --version
                    npm ci
                    npm test
                '''
            }
        }
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    ls -al
                    npm ci
                    npm run build
                    ls -al
                    test -f build/manifest.json || { echo "manifest.json not found!"; exit 1; }
                    test -f build/index.html || { echo "index.html not found!"; exit 1; }
                '''
            }
        }
        stage('AWS') {
            agent {
                docker {
                    image 'amazon/aws-cli'
                    args "--entrypoint=''"
                }
            }
            environment {
                AWS_S3_BUCKET = 'learn-jenkins-835263433501-us-east-1-an'
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'aws-s3-bucket', passwordVariable: 'AWS_SECRET_ACCESS_KEY', usernameVariable: 'AWS_ACCESS_KEY_ID')]) {
                    sh '''
                        echo "AWS Stage"
                        aws --version
                        aws s3 sync build/ s3://$AWS_S3_BUCKET/
                    '''
                }
            }
        }
    }

    post {
        always {
            junit testResults: '**/jest-results.xml', allowEmptyResults: true
        }
    }
}