{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "LearnJenkinsApp-TaskDefinition",
    "containerDefinitions": [
        {
            "name": "learn-jenkins-app",
            "image": "835263433501.dkr.ecr.us-east-1.amazonaws.com/learn-jenkins-app:#APP_VERSION#",
            "portMappings": [
                {
                    "name": "nginx-80-tip",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"                    
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "2 GB",
    "cpu": "1 vCPU",
    "executionRoleArn": "arn:aws:iam::835263433501:role/ecsTaskExecutionRole"
}